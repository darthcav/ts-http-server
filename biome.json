{
    "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
    "files": {
        "includes": ["src/**", "*.json", "!package-lock.json"]
    },
    "formatter": {
        "bracketSpacing": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineEnding": "lf"
    },
    "javascript": {
        "formatter": {
            "semicolons": "asNeeded"
        }
    },
    "yaml": {
        "formatter": {
            "bracketSpacing": false,
            "indentWidth": 2
        }
    },
    "linter": {
        "rules": {
            "preset": "recommended",
            "complexity": {
                "useLiteralKeys": "off"
            },
            "style": {
                "useBlockStatements": "error",
                "useImportsFirst": "error"
            }
        }
    }
}
